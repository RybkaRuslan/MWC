# Автоматическое определение текстовых файлов и выполнение нормализации LF
* text=auto

# Окончания строк для различных типов файлов
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.html text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Файлы конфигурации
*.gitignore text eol=lf
*.gitattributes text eol=lf
.eslintrc* text eol=lf
.prettierrc* text eol=lf
*.config.js text eol=lf
*.config.ts text eol=lf
package.json text eol=lf
package-lock.json text eol=lf
yarn.lock text eol=lf

# Исключить файлы из экспорта архива
.gitattributes export-ignore
.gitignore export-ignore
.github export-ignore
.vscode export-ignore
.idea export-ignore

# Бинарные файлы
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mov binary
*.mp4 binary
*.mp3 binary
*.flv binary
*.fla binary
*.swf binary
*.gz binary
*.zip binary
*.7z binary
*.ttf binary
*.eot binary
*.woff binary
*.woff2 binary
*.pdf binary

# Файлы шрифтов
*.woff linguist-vendored
*.woff2 linguist-vendored 